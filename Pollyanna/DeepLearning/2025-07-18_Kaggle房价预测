# 1.下载数据集

这里便写了三个函数来获取数据集。

第一个函数`download`，用于下载一个文件并**通过 SHA-1 哈希值**验证其完整性

```python
def download(name, cache_dir=os.path.join('..', 'data')):  #@save
    """下载一个DATA_HUB中的文件，返回本地文件名"""
    assert name in DATA_HUB, f"{name} 不存在于 {DATA_HUB}"    #检查DATA_HUB字典里是否有这个name
    url, sha1_hash = DATA_HUB[name]                          #从 DATA_HUB这个字典里根据name获取url, sha1_hash
    os.makedirs(cache_dir, exist_ok=True)					
    fname = os.path.join(cache_dir, url.split('/')[-1])		#从URL中提取文件，取最后一个/后的内容，然后与缓存目录拼接，得到完整的本地文件路径
    
    if os.path.exists(fname):
        sha1 = hashlib.sha1()
        with open(fname, 'rb') as f:
            while True:
                data = f.read(1048576)
                if not data:
                    break
                sha1.update(data)
        if sha1.hexdigest() == sha1_hash:
            return fname  # 命中缓存						#如果本地已经存在这个文件，比较计算出的哈希值与预期的是否一致如果一致，说明文件完整，直接返回文件路径
        
    print(f'正在从{url}下载{fname}...')
    r = requests.get(url, stream=True, verify=True)
    with open(fname, 'wb') as f:
        f.write(r.content)
    return fname											#如果没有，从url下载文件，并写入创建的文件夹，返回本地文件路径。
```

接下来，两个函数

* `download_extract()` 适合用于下载并解压数据集（如 `.zip` 数据包）；
* `download_all()` 更适合预下载所有资源（比如模型、配置文件等），但不立即解压；

```python
def download_extract(name, folder=None):  #@save
    """下载并解压zip/tar文件"""
    fname = download(name)
    base_dir = os.path.dirname(fname)
    data_dir, ext = os.path.splitext(fname)
    if ext == '.zip':
        fp = zipfile.ZipFile(fname, 'r')
    elif ext in ('.tar', '.gz'):
        fp = tarfile.open(fname, 'r')
    else:
        assert False, '只有zip/tar文件可以被解压缩'
    fp.extractall(base_dir)
    return os.path.join(base_dir, folder) if folder else data_dir

def download_all():  #@save
    """下载DATA_HUB中的所有文件"""
    for name in DATA_HUB:
        download(name)
```

